# Copie este archivo a .env (en la raíz del proyecto) y complete los valores. El .env NO se sube a git.

# Supabase > Connect > Session pooler (puerto 5432)
DATABASE_URL=postgresql://postgres.PROYECTO:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# Servidor MCP (la clave se genera al azar y se copia en la credencial "MCP API Key" de n8n)
MCP_API_KEY=
MCP_PORT=9000
MCP_URL=http://IP_PUBLICA_EC2:9000

# Webhook del flujo 00 de n8n y su token (se copian en Ajustes de la app)
N8N_WEBHOOK_URL=https://SU-INSTANCIA.app.n8n.cloud/webhook/unab-chat
CHAT_TOKEN=

# Instancia de n8n y token de su MCP (Settings > Instance-level MCP). Opcionales: los flujos se importan a mano con Import from File
N8N_URL=https://SU-INSTANCIA.app.n8n.cloud
N8N_API_KEY=

# Hoja de Google Sheets con el calendario académico
GOOGLE_SHEET_ID=
