# Copia a .env y completa. Nunca subas .env al repositorio.
# Cadena del pooler de Supabase (Project Settings > Database > Connection string), con sslmode=require
DATABASE_URL=postgresql://postgres.xxxx:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Clave compartida: n8n y las pruebas la envían en el encabezado X-API-Key
MCP_API_KEY=cambia-esta-clave-larga-y-aleatoria
MCP_PORT=9000
# Solo para la herramienta buscar_documentos (embedding de la pregunta)
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
