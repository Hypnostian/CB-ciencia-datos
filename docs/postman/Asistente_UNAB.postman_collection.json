{
  "info": {
    "name": "Asistente Académico UNAB (webhook n8n)",
    "_postman_id": "b7a2f3c4-4d1e-4c8a-9f10-2026cbda7a00",
    "description": "Pruebas del webhook POST /webhook/unab-chat del flujo 00 de n8n (contrato en docs/CONTRATO.md). Antes de usarla, ponga en las variables de la colección la URL del webhook y el CHAT_TOKEN (están en el .env, que no se sube).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "webhook_url",
      "value": "https://SU-INSTANCIA.app.n8n.cloud/webhook/unab-chat"
    },
    {
      "key": "chat_token",
      "value": "PEGAR_CHAT_TOKEN"
    }
  ],
  "item": [
    {
      "name": "1. Matrícula actual",
      "request": {
        "method": "POST",
        "description": "Intención matricula: cursos inscritos con NRC, horario y profesor (herramienta estado_matricula).",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Chat-Token",
            "value": "{{chat_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estudiante_codigo\": \"U00179961\",\n  \"session_id\": \"postman-demo\",\n  \"mensaje\": \"¿En qué materias estoy matriculada este semestre y con qué profesores?\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{webhook_url}}",
          "host": [
            "{{webhook_url}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Trae respuesta', () => pm.expect(j.respuesta).to.be.a('string').and.not.empty);",
              "pm.test('Intención matricula o cursos', () => pm.expect(['matricula','cursos']).to.include(j.intencion));"
            ]
          }
        }
      ]
    },
